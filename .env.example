# Copia este fichero a .env en la raíz del repo y rellénalo. .env nunca se commitea.

# --- Embeddings: Cloudflare Workers AI ---
# ID de tu cuenta de Cloudflare (Workers & Pages > panel derecho, o la URL del dashboard)
CLOUDFLARE_ACCOUNT_ID=
# Token de API con permiso "Workers AI" (Manage Account > API Tokens). Solo backend
CLOUDFLARE_API_TOKEN=
# Modelo de embeddings (1024 dimensiones; la tabla fragmentos usa vector(1024))
EMBEDDING_MODEL=@cf/baai/bge-m3

# --- Base de datos: Neon (Postgres + pgvector, región Frankfurt) ---
# Cadena de conexión de la rama "development" de Neon (con ?sslmode=require).
# La rama "production" se usa solo en el despliegue, nunca en local.
DATABASE_URL=

# --- Generación de respuestas (fase 3): Cloudflare Workers AI ---
# Usa la misma cuenta y token que los embeddings (no hace falta otra clave).
# Modelo (alternativa más barata: @cf/openai/gpt-oss-20b)
LLM_MODEL=@cf/openai/gpt-oss-120b
# Tope de tokens generados; INCLUYE los de razonamiento del modelo. Si la respuesta sale truncada (error «truncada por max_tokens»), súbelo
LLM_MAX_TOKENS=3000

# --- Recuperación y abstención ---
# Similitud mínima del mejor artículo/anexo para llamar al LLM; por debajo, responde "no lo sé" (PROVISIONAL: con 0.60 se rechazaba una pregunta legítima con similitud 0.526; se calibra en la fase 4)
UMBRAL_SIMILITUD=0.50
# Fragmentos recuperados: artículos+anexos (citables) y considerandos (solo contexto)
K_ARTICULOS=5
K_CONSIDERANDOS=2
# Presupuesto de caracteres del contexto enviado al modelo (no se cortan fragmentos a la mitad)
PRESUPUESTO_CONTEXTO_CARACTERES=10000
