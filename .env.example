# URL del proyecto de Supabase (Settings > API)
SUPABASE_URL=
# Clave service_role de Supabase. Solo backend; nunca en el frontend ni en el repo
SUPABASE_SERVICE_KEY=
# API key de Groq para la generación de respuestas
GROQ_API_KEY=
# Modelo de embeddings multilingüe (p. ej. BAAI/bge-m3)
EMBEDDING_MODEL=
