# Copia este fichero a .env en la raíz del repo y rellénalo. .env nunca se commitea.

# --- Embeddings: Cloudflare Workers AI ---
# ID de tu cuenta de Cloudflare (Workers & Pages > panel derecho, o la URL del dashboard)
CLOUDFLARE_ACCOUNT_ID=
# Token de API con permiso "Workers AI" (Manage Account > API Tokens). Solo backend
CLOUDFLARE_API_TOKEN=
# Modelo de embeddings (1024 dimensiones; la tabla fragmentos usa vector(1024))
EMBEDDING_MODEL=@cf/baai/bge-m3

# --- Base de datos: Neon (Postgres + pgvector, región Frankfurt) ---
# Cadena de conexión de la rama "development" de Neon (con ?sslmode=require).
# La rama "production" se usa solo en el despliegue, nunca en local.
DATABASE_URL=

# --- Generación de respuestas (fase 3) ---
# API key de Groq
GROQ_API_KEY=
